import json
import os
import random
import re
import time
import traceback
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime
import html
from pathlib import Path
import urllib.parse
import xml.etree.ElementTree as ET

import requests  # Você precisará instalar: pip install requests

BASE_DIR = Path(__file__).resolve().parent
ARQUIVO_ENVIADOS = Path(os.getenv("ARXIV_ENVIADOS_PATH", BASE_DIR / "arxiv_enviados.json"))
FUSO_LOCAL_HORAS = -3  # Brasil (ajuste se necessário)
DIAS_ATRAS_FILTRO = 1  # 1 = ontem
ARXIV_USER_AGENT = os.getenv(
    "ARXIV_USER_AGENT",
    "arxiv-whatsapp-notifier/1.0 (mailto:alexia@example.com)",
)

def enviar_whatsapp(mensagem, api_key, telefone):
    mensagem_codificada = urllib.parse.quote(mensagem)
    url = (
        "https://api.callmebot.com/whatsapp.php"
        f"?phone={telefone}&text={mensagem_codificada}&apikey={api_key}"
    )
    resposta = requests.get(url, timeout=30)
    corpo = resposta.text.strip().lower()
    if resposta.status_code != 200 or "error" in corpo or "invalid" in corpo:
        raise RuntimeError(f"Falha ao enviar WhatsApp: status={resposta.status_code}, resposta={resposta.text}")


def validar_api_key(api_key):
    api = str(api_key).strip()
    if not api or api == "YOUR_API_KEY_HERE":
        raise ValueError("API_KEY não definida.")
    if not api.isdigit() or len(api) < 6:
        raise ValueError("API_KEY parece inválida. Verifique a chave recebida do CallMeBot.")


def carregar_ids_enviados():
    if not os.path.exists(ARQUIVO_ENVIADOS):
        return set()
    try:
        with open(ARQUIVO_ENVIADOS, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, list):
            return set(data)
    except Exception:
        pass
    return set()


def salvar_ids_enviados(ids):
    ARQUIVO_ENVIADOS.parent.mkdir(parents=True, exist_ok=True)
    with open(ARQUIVO_ENVIADOS, "w", encoding="utf-8") as f:
        json.dump(sorted(ids), f, ensure_ascii=False, indent=2)


def parse_data_arxiv_iso(texto_iso):
    dt_utc = datetime.fromisoformat(texto_iso.replace("Z", "+00:00"))
    tz_local = timezone(timedelta(hours=FUSO_LOCAL_HORAS))
    return dt_utc.astimezone(tz_local).date()


def buscar_arxiv_com_retentativas(url_arxiv, tentativas=4, timeout=45):
    headers = {
        "User-Agent": ARXIV_USER_AGENT,
        "Accept": "application/atom+xml,text/xml;q=0.9,*/*;q=0.8",
    }
    for tentativa in range(1, tentativas + 1):
        try:
            resposta_arxiv = requests.get(url_arxiv, headers=headers, timeout=timeout)
            if resposta_arxiv.status_code == 429:
                retry_after = resposta_arxiv.headers.get("Retry-After")
                if retry_after and retry_after.isdigit():
                    espera = int(retry_after)
                else:
                    # Backoff progressivo com jitter para reduzir chance de novo 429.
                    espera = min(120, 20 * tentativa) + random.randint(0, 5)
                print(
                    f"Tentativa {tentativa}/{tentativas} recebeu 429. "
                    f"Aguardando {espera}s antes da próxima tentativa..."
                )
                if tentativa < tentativas:
                    time.sleep(espera)
                    continue
                return None
            resposta_arxiv.raise_for_status()
            return resposta_arxiv.content
        except requests.RequestException as e:
            print(f"Tentativa {tentativa}/{tentativas} falhou ao consultar o arXiv: {e}")
            if tentativa < tentativas:
                espera = 8 + (tentativa * 5)
                time.sleep(espera)
            else:
                return None


def limpar_html(texto):
    if not texto:
        return ""
    texto = html.unescape(texto)
    texto = re.sub(r"<[^>]+>", " ", texto)
    return re.sub(r"\s+", " ", texto).strip()


def buscar_arxiv_via_rss(categorias, timeout=30):
    headers = {"User-Agent": ARXIV_USER_AGENT}
    artigos = []
    for categoria in categorias:
        url_rss = f"https://rss.arxiv.org/rss/{categoria}"
        try:
            resposta = requests.get(url_rss, headers=headers, timeout=timeout)
            resposta.raise_for_status()
            root_rss = ET.fromstring(resposta.content)
        except (requests.RequestException, ET.ParseError) as e:
            print(f"Falha ao buscar RSS de {categoria}: {e}")
            continue

        for item in root_rss.findall("./channel/item"):
            titulo_node = item.find("title")
            link_node = item.find("link")
            desc_node = item.find("description")
            data_node = item.find("pubDate")
            if titulo_node is None or link_node is None or data_node is None:
                continue

            link_abs = (link_node.text or "").strip()
            if not link_abs:
                continue

            try:
                data_pub = parsedate_to_datetime((data_node.text or "").strip())
                data_pub_iso = data_pub.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
            except Exception:
                continue

            artigos.append(
                {
                    "title": (titulo_node.text or "").strip(),
                    "summary": limpar_html(desc_node.text if desc_node is not None else ""),
                    "id": link_abs,
                    "published": data_pub_iso,
                }
            )
    return artigos

def buscar_e_notificar_arxiv():
    # Configurações do usuário (pode vir de variáveis de ambiente ou hardcoded)
    API_KEY = os.getenv("ARXIV_API_KEY", "4885091")
    TELEFONE = os.getenv("ARXIV_TELEFONE", "5511959452561") # Ex: 5511999999999

    try:
        validar_api_key(API_KEY)
    except ValueError as e:
        print(f"Configuração inválida: {e}")
        return
    
    categorias = ['cond-mat.supr-con', 'cond-mat.str-el']
    termos = ['Mott', 'Superconductivity', 'Hubbard', 'Cuprate', 'Majorana', 'Moiré', 'Pressure', 'Van der Waals', 'Graphene', 'Topological', 'Spin liquid', 'Kagome', 'Frustrated', 'Quantum criticality', 'Unconventional superconductivity', 'High-Tc', 'Twisted bilayer', 'Spin-orbit coupling']
    max_resultados = int(os.getenv("ARXIV_MAX_RESULTADOS", "100"))

    ids_enviados = carregar_ids_enviados()
    enviados_hoje = 0
    data_local = datetime.now(timezone(timedelta(hours=FUSO_LOCAL_HORAS))).date()
    data_alvo = data_local - timedelta(days=DIAS_ATRAS_FILTRO)
    
    # Query na API do arXiv
    query = "+OR+".join([f"cat:{c}" for c in categorias])
    url_arxiv = (
        "https://export.arxiv.org/api/query"
        f"?search_query={query}&sortBy=submittedDate&sortOrder=descending&max_results={max_resultados}"
    )

    artigos = []
    conteudo_arxiv = buscar_arxiv_com_retentativas(url_arxiv, tentativas=4, timeout=45)
    if conteudo_arxiv:
        try:
            root = ET.fromstring(conteudo_arxiv)
            ns = {'atom': 'http://www.w3.org/2005/Atom'}
            for entry in root.findall('atom:entry', ns):
                titulo_node = entry.find('atom:title', ns)
                resumo_node = entry.find('atom:summary', ns)
                id_node = entry.find('atom:id', ns)
                data_node = entry.find('atom:published', ns)

                if titulo_node is None or resumo_node is None or id_node is None or data_node is None:
                    continue

                artigos.append(
                    {
                        "title": titulo_node.text.strip().replace('\n', ' '),
                        "summary": resumo_node.text,
                        "id": id_node.text.strip(),
                        "published": data_node.text.strip(),
                    }
                )
        except ET.ParseError as e:
            print(f"Falha ao interpretar resposta XML do arXiv API: {e}")

    if not artigos:
        print("API do arXiv indisponível/rate-limited. Tentando fallback via RSS...")
        artigos = buscar_arxiv_via_rss(categorias)

    if not artigos:
        print("Falha ao obter artigos via API e via RSS. Encerrando execução sem erro fatal.")
        return

    for artigo in artigos:
        titulo = artigo["title"]
        resumo = (artigo.get("summary") or "").lower()
        link_abs = artigo["id"]
        link_pdf = link_abs.replace('/abs/', '/pdf/') + '.pdf'
        artigo_id = link_abs

        # Apenas artigos da data-alvo (padrão: ontem)
        data_artigo = parse_data_arxiv_iso(artigo["published"])
        if data_artigo != data_alvo:
            continue

        # Evita duplicados entre execuções
        if artigo_id in ids_enviados:
            continue

        # Filtro por termos de interesse
        if any(t.lower() in (titulo.lower() + resumo) for t in termos):
            msg = (
                "*Novo Artigo arXiv*\n\n"
                f"*Título:* {titulo}\n\n"
                f"*Resumo:* {link_abs}\n"
                f"*PDF:* {link_pdf}"
            )
            try:
                enviar_whatsapp(msg, API_KEY, TELEFONE)
                ids_enviados.add(artigo_id)
                salvar_ids_enviados(ids_enviados)  # Salva incrementalmente para não perder em caso de erro
                enviados_hoje += 1
                print(f"Enviado: {titulo[:70]}...")
            except RuntimeError as e:
                print(f"ERRO ao enviar '{titulo[:60]}': {e}")
                print("Aguardando 30s antes de continuar...")
                time.sleep(30)
                continue
            time.sleep(10)  # Pausa para evitar rate limiting do CallMeBot

    salvar_ids_enviados(ids_enviados)
    print(f"Data-alvo do filtro: {data_alvo}")
    print(f"Total enviado: {enviados_hoje}")
    if enviados_hoje == 0:
        print("Nenhum artigo enviado. Verifique as datas abaixo para diagnosticar:")
        for artigo in artigos[:20]:
            data_artigo = parse_data_arxiv_iso(artigo["published"])
            print(f"  data={data_artigo} | {artigo['title'][:60]}")

if __name__ == "__main__":
    try:
        buscar_e_notificar_arxiv()
    except Exception as e:
        print(f"Erro inesperado durante execução: {e}")
        print(traceback.format_exc())
        print("Execução finalizada sem falha fatal para manter o workflow agendado ativo.")